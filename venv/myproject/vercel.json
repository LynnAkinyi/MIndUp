{
    "builds": [{
            "src": "build_files.sh",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "staticfiles_build"
            }
        },
        {
            "src": "czarny_kot/wsgi.py",
            "use": "@vercel/python",
            "config": { "maxLambdaSize": "15mb" }
        }
    ],
    "routes": [{
            "src": "/static/(.*)",
            "headers": { "cache-control": "s-maxage=604800" },
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "czarny_kot/wsgi.py"
        }
    ]
}
